# ─── Redis ────────────────────────────────────────────────────────────────────
# REDIS_ENABLED=false → InMemoryOtpRateLimiterService (no Redis needed for local dev)
# REDIS_ENABLED=true  → RedisOtpRateLimiterService (requires a real REDIS_URL)
REDIS_ENABLED=false
REDIS_URL="rediss://default:TOKEN@hostname.upstash.io:6380"

