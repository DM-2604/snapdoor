  status                   OrderStatus           @default(PLACED)
  deliveredByStaffId       String?               @map("delivered_by_staff_id") @db.Uuid
  subtotal                 Decimal               @db.Decimal(12, 2)
  deliveryFee              Decimal               @default(0) @map("delivery_fee") @db.Decimal(8, 2)
  discountAmount           Decimal               @default(0) @map("discount_amount") @db.Decimal(12, 2) // total offer/coupon discount applied
  commissionPercentApplied Decimal               @map("commission_percent_applied") @db.Decimal(5, 2)
  commissionAmount         Decimal               @map("commission_amount") @db.Decimal(12, 2)
  totalAmount              Decimal               @map("total_amount") @db.Decimal(12, 2)
  paymentMethod            PaymentMethod         @map("payment_method")
  storeNotes               String?               @map("store_notes")
  placedAt                 DateTime?             @map("placed_at") @db.Timestamptz(6)
  acceptedAt               DateTime?             @map("accepted_at") @db.Timestamptz(6)
  readyAt                  DateTime?             @map("ready_at") @db.Timestamptz(6)
  completedAt              DateTime?             @map("completed_at") @db.Timestamptz(6)
  cancelledReason          String?               @map("cancelled_reason")
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String?               @map("created_by") @db.Uuid
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?               @map("updated_by") @db.Uuid
  channel                  OrderChannel          @default(APP)
  recordedByUserId         String?               @map("recorded_by_user_id") @db.Uuid
  deliveryAssignment       DeliveryAssignment?
  inventoryAdjustments     InventoryAdjustment[]
  customerContact          OrderCustomerContact?
  items                    OrderItem[]
  statusHistory            OrderStatusHistory[]
  appliedOffers            AppliedOffer[]
  customer                 User?                 @relation(fields: [customerId], references: [id])
  deliveryStaff            StoreDeliveryStaff?   @relation(fields: [deliveredByStaffId], references: [id])
  recordedByUser           User?                 @relation("PosOrdersRecorded", fields: [recordedByUserId], references: [id])
  store                    Store                 @relation(fields: [storeId], references: [id])
  payments                 Payment[]
  refunds                  Refund[]
  review                   Review?
  salesInvoice             SalesInvoice?

  @@index([customerId, createdAt])
  @@index([storeId, status, createdAt])
  @@map("orders")
}

