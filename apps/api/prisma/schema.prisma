generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, postgis, uuid_ossp(map: "uuid-ossp")]
}

model City {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  state                    String
  country                  String                    @default("India")
  timezone                 String                    @default("Asia/Kolkata")
  status                   CityStatus                @default(PLANNED)
  launchDate               DateTime?                 @map("launch_date") @db.Date
  currencyCode             String                    @default("INR") @map("currency_code")
  defaultCommissionPercent Decimal?                  @map("default_commission_percent") @db.Decimal(5, 2)
  isDeliveryFleetEnabled   Boolean                   @default(false) @map("is_delivery_fleet_enabled")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String?                   @map("created_by") @db.Uuid
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?                   @map("updated_by") @db.Uuid
  deletedAt                DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  deletedBy                String?                   @map("deleted_by") @db.Uuid
  center_location          Unsupported("geography")?
  carousels                Carousel[]
  commissionRules          CommissionRule[]
  platformFeePlans         PlatformFeePlan[]
  stores                   Store[]
  themes                   Theme[]
  zones                    Zone[]

  @@map("cities")
}

model Zone {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId                   String                     @map("city_id") @db.Uuid
  name                     String
  code                     String
  colorHex                 String?                    @map("color_hex")
  isActive                 Boolean                    @default(true) @map("is_active")
  defaultCommissionPercent Decimal?                   @map("default_commission_percent") @db.Decimal(5, 2)
  storeCount               Int                        @default(0) @map("store_count")
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                String?                    @map("created_by") @db.Uuid
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                String?                    @map("updated_by") @db.Uuid
  deletedAt                DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  deletedBy                String?                    @map("deleted_by") @db.Uuid
  centroid                 Unsupported("geography")?
  boundary                 Unsupported("geography")?
  carousels                Carousel[]
  commissionRules          CommissionRule[]
  deliveryPartners         DeliveryPartner[]
  zoneReassignmentLogs     StoreZoneReassignmentLog[] @relation("NewZone")
  zoneReassignmentLogsOld  StoreZoneReassignmentLog[] @relation("OldZone")
  stores                   Store[]
  city                     City                       @relation(fields: [cityId], references: [id])

  @@unique([cityId, code])
  @@map("zones")
}

model CommissionRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId            String?   @map("city_id") @db.Uuid
  zoneId            String?   @map("zone_id") @db.Uuid
  categoryId        String?   @map("category_id") @db.Uuid
  storeId           String?   @map("store_id") @db.Uuid
  commissionPercent Decimal   @map("commission_percent") @db.Decimal(5, 2)
  effectiveFrom     DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(6)
  reason            String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?   @map("deleted_by") @db.Uuid
  category          Category? @relation(fields: [categoryId], references: [id])
  city              City?     @relation(fields: [cityId], references: [id])
  store             Store?    @relation(fields: [storeId], references: [id])
  zone              Zone?     @relation(fields: [zoneId], references: [id])

  @@map("commission_rules")
}

model PlatformFeePlan {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId           String?             @map("city_id") @db.Uuid
  name             String
  planType         PlatformFeePlanType @map("plan_type")
  monthlyFee       Decimal?            @map("monthly_fee") @db.Decimal(12, 2)
  setupFee         Decimal?            @map("setup_fee") @db.Decimal(12, 2)
  billingFrequency BillingFrequency    @default(MONTHLY) @map("billing_frequency")
  isActive         Boolean             @default(true) @map("is_active")
  effectiveFrom    DateTime            @map("effective_from") @db.Date
  effectiveTo      DateTime?           @map("effective_to") @db.Date
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?             @map("created_by") @db.Uuid
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?             @map("updated_by") @db.Uuid
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)
  deletedBy        String?             @map("deleted_by") @db.Uuid
  city             City?               @relation(fields: [cityId], references: [id])
  storeBillings    StoreBilling[]

  @@map("platform_fee_plans")
}

model PlatformSetting {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique
  value       Json
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid

  @@map("platform_settings")
}

model StoreBilling {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String          @unique @map("store_id") @db.Uuid
  platformFeePlanId   String          @map("platform_fee_plan_id") @db.Uuid
  gstNumber           String?         @map("gst_number")
  gstRegistered       Boolean         @default(false) @map("gst_registered")
  panNumber           String?         @map("pan_number")
  gstInvoiceRequired  Boolean         @default(false) @map("gst_invoice_required")
  billingCycleDay     Int             @default(1) @map("billing_cycle_day") @db.SmallInt
  billingEmail        String?         @map("billing_email")
  billingContactPhone String?         @map("billing_contact_phone")
  invoicePrefix       String?         @map("invoice_prefix")
  nextInvoiceSequence Int             @default(1) @map("next_invoice_sequence")
  autoDebitConsent    Boolean         @default(false) @map("auto_debit_consent")
  payoutAccountId     String?         @map("payout_account_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?         @map("created_by") @db.Uuid
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?         @map("updated_by") @db.Uuid
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?         @map("deleted_by") @db.Uuid
  invoices            Invoice[]
  payoutAccount       PayoutAccount?  @relation(fields: [payoutAccountId], references: [id])
  platformFeePlan     PlatformFeePlan @relation(fields: [platformFeePlanId], references: [id])
  store               Store           @relation(fields: [storeId], references: [id])

  @@map("store_billing")
}

/// LocalMart billing the Store for commission and platform fees — distinct from SalesInvoice (Store billing Customer)
model Invoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String        @map("store_id") @db.Uuid
  storeBillingId   String        @map("store_billing_id") @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number")
  periodStart      DateTime      @map("period_start") @db.Date
  periodEnd        DateTime      @map("period_end") @db.Date
  commissionTotal  Decimal       @default(0) @map("commission_total") @db.Decimal(12, 2)
  platformFeeTotal Decimal       @default(0) @map("platform_fee_total") @db.Decimal(12, 2)
  cgstAmount       Decimal       @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount       Decimal       @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount       Decimal       @default(0) @map("igst_amount") @db.Decimal(12, 2)
  placeOfSupply    String?       @map("place_of_supply")
  netPayable       Decimal       @map("net_payable") @db.Decimal(12, 2)
  status           InvoiceStatus @default(DRAFT)
  dueDate          DateTime      @map("due_date") @db.Date
  pdfUrl           String?       @map("pdf_url")
  sentAt           DateTime?     @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?       @map("created_by") @db.Uuid
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?       @map("updated_by") @db.Uuid
  storeBilling     StoreBilling  @relation(fields: [storeBillingId], references: [id])
  store            Store         @relation(fields: [storeId], references: [id])

  @@index([storeId, periodStart])
  @@map("invoices")
}

model User {
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber             String                     @unique @map("phone_number")
  name                    String?
  email                   String?
  role                    UserRole
  authProvider            AuthProvider               @default(PHONE_OTP) @map("auth_provider")
  isBlocked               Boolean                    @default(false) @map("is_blocked")
  blockedReason           String?                    @map("blocked_reason")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy               String?                    @map("created_by") @db.Uuid
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy               String?                    @map("updated_by") @db.Uuid
  deletedAt               DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  deletedBy               String?                    @map("deleted_by") @db.Uuid
  adminUser               AdminUser?
  auditLogs               AuditLog[]
  carts                   Cart[]
  devices                 Device[]
  documents               Document[]                 @relation("DocumentCreator")
  inventoryAdjustments    InventoryAdjustment[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference[]
  orderStatusHistory      OrderStatusHistory[]
  orders                  Order[]
  posOrdersRecorded       Order[]                    @relation("PosOrdersRecorded")
  refundsInitiated        Refund[]                   @relation("RefundInitiator")
  reviews                 Review[]
  sessions                Session[]
  storeOwner              StoreOwner?
  zoneReassignmentLogs    StoreZoneReassignmentLog[]
  stores                  Store[]                    @relation("StoreOwner")

  @@map("users")
}

model StoreOwner {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  kycStatus  KycStatus @default(NOT_STARTED) @map("kyc_status")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy  String?   @map("deleted_by") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])

  @@map("store_owners")
}

model AdminUser {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String               @unique @map("user_id") @db.Uuid
  adminRole         AdminRole            @map("admin_role")
  permissions       Json?
  isActive          Boolean              @default(true) @map("is_active")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?              @map("created_by") @db.Uuid
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?              @map("updated_by") @db.Uuid
  deletedAt         DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?              @map("deleted_by") @db.Uuid
  user              User                 @relation(fields: [userId], references: [id])
  verifiedDocuments Document[]           @relation("DocumentVerifier")
  approvalQueue     StoreApprovalQueue[]

  @@map("admin_users")
}

/// Append-only — no soft delete
model OtpRequest {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber       String     @map("phone_number")
  otpHash           String     @map("otp_hash")
  purpose           OtpPurpose
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(6)
  attemptCount      Int        @default(0) @map("attempt_count") @db.SmallInt
  isVerified        Boolean    @default(false) @map("is_verified")
  ipAddress         String?    @map("ip_address")
  deviceFingerprint String?    @map("device_fingerprint")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneNumber, createdAt])
  @@map("otp_requests")
}

model Device {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  pushToken    String?        @map("push_token")
  platform     DevicePlatform
  lastActiveAt DateTime?      @map("last_active_at") @db.Timestamptz(6)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?        @map("created_by") @db.Uuid
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?        @map("updated_by") @db.Uuid
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?        @map("deleted_by") @db.Uuid
  user         User           @relation(fields: [userId], references: [id])
  sessions     Session[]

  @@map("devices")
}

/// Append-only — no soft delete
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  ipAddress        String?   @map("ip_address")
  device           Device?   @relation(fields: [deviceId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Document {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType          DocumentOwnerType          @map("owner_type")
  ownerId            String                     @map("owner_id") @db.Uuid
  docType            DocType                    @map("doc_type")
  fileUrl            String                     @map("file_url")
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedBy         String?                    @map("verified_by") @db.Uuid
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(6)
  rejectionReason    String?                    @map("rejection_reason")
  expiresAt          DateTime?                  @map("expires_at") @db.Date
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?                    @map("created_by") @db.Uuid
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?                    @map("updated_by") @db.Uuid
  deletedAt          DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?                    @map("deleted_by") @db.Uuid
  creator            User?                      @relation("DocumentCreator", fields: [createdBy], references: [id])
  verifier           AdminUser?                 @relation("DocumentVerifier", fields: [verifiedBy], references: [userId])

  @@index([ownerType, ownerId])
  @@map("documents")
}

model PayoutAccount {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType           PayoutAccountOwnerType   @map("owner_type")
  ownerId             String                   @map("owner_id") @db.Uuid
  accountType         PayoutAccountType        @map("account_type")
  accountHolderName   String?                  @map("account_holder_name")
  accountNumberMasked String?                  @map("account_number_masked")
  ifscCode            String?                  @map("ifsc_code")
  upiVpa              String?                  @map("upi_vpa")
  isPrimary           Boolean                  @default(true) @map("is_primary")
  verificationStatus  PayoutVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt          DateTime?                @map("verified_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?                  @map("created_by") @db.Uuid
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?                  @map("updated_by") @db.Uuid
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?                  @map("deleted_by") @db.Uuid
  settlements         Settlement[]
  storeBillings       StoreBilling[]

  @@index([ownerType, ownerId])
  @@map("payout_accounts")
}

model Store {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId                String                     @map("owner_user_id") @db.Uuid
  cityId                     String                     @map("city_id") @db.Uuid
  zoneId                     String?                    @map("zone_id") @db.Uuid
  storeCode                  String                     @unique @map("store_code")
  name                       String
  description                String?
  businessCategoryId         String                     @map("business_category_id") @db.Uuid
  address                    String
  geoPinAccuracy             Decimal?                   @map("geo_pin_accuracy") @db.Decimal(6, 2)
  status                     StoreStatus                @default(DRAFT)
  rejectionReason            String?                    @map("rejection_reason")
  onboardingSource           OnboardingSource           @default(SELF_SERVE) @map("onboarding_source")
  photos                     Json?
  takeawayEnabled            Boolean                    @default(true) @map("takeaway_enabled")
  deliveryEnabled            Boolean                    @default(false) @map("delivery_enabled")
  deliveryRadiusKm           Decimal?                   @map("delivery_radius_km") @db.Decimal(4, 1)
  deliveryFee                Decimal?                   @map("delivery_fee") @db.Decimal(8, 2)
  avgPrepTimeMinutes         Int?                       @map("avg_prep_time_minutes") @db.SmallInt
  isTemporarilyPaused        Boolean                    @default(false) @map("is_temporarily_paused")
  pausedUntil                DateTime?                  @map("paused_until") @db.Timestamptz(6)
  pauseReason                String?                    @map("pause_reason")
  effectiveCommissionPercent Decimal?                   @map("effective_commission_percent") @db.Decimal(5, 2)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                  String?                    @map("created_by") @db.Uuid
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy                  String?                    @map("updated_by") @db.Uuid
  deletedAt                  DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  deletedBy                  String?                    @map("deleted_by") @db.Uuid
  location                   Unsupported("geography")?
  carts                      Cart[]
  commissionRules            CommissionRule[]
  invoices                   Invoice[]
  orders                     Order[]
  offers                     Offer[]
  products                   Product[]
  reviews                    Review[]
  sales                      Sale[]
  settlements                Settlement[]
  approvalQueue              StoreApprovalQueue[]
  billing                    StoreBilling?
  storeCategories            StoreCategory[]
  subCategories              Category[]                 @relation("StoreSubCategories")
  deliveryStaff              StoreDeliveryStaff[]
  hourExceptions             StoreHourException[]
  operatingHours             StoreOperatingHour[]
  zoneReassignmentLogs       StoreZoneReassignmentLog[]
  businessCategory           Category                   @relation("BusinessCategory", fields: [businessCategoryId], references: [id])
  city                       City                       @relation(fields: [cityId], references: [id])
  owner                      User                       @relation("StoreOwner", fields: [ownerUserId], references: [id])
  zone                       Zone?                      @relation(fields: [zoneId], references: [id])

  @@index([cityId, status])
  @@map("stores")
}

model StoreOperatingHour {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  dayOfWeek Int       @map("day_of_week") @db.SmallInt
  openTime  String?   @map("open_time")
  closeTime String?   @map("close_time")
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  store     Store     @relation(fields: [storeId], references: [id])

  @@unique([storeId, dayOfWeek])
  @@map("store_operating_hours")
}

model StoreHourException {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  exceptionDate DateTime  @map("exception_date") @db.Date
  isClosed      Boolean   @default(true) @map("is_closed")
  openTime      String?   @map("open_time")
  closeTime     String?   @map("close_time")
  reason        String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  store         Store     @relation(fields: [storeId], references: [id])

  @@unique([storeId, exceptionDate])
  @@map("store_hour_exceptions")
}

model StoreDeliveryStaff {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  name      String
  phone     String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  orders    Order[]
  store     Store     @relation(fields: [storeId], references: [id])

  @@map("store_delivery_staff")
}

model Category {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentCategoryId String?          @map("parent_category_id") @db.Uuid
  storeId          String?          @map("store_id") @db.Uuid
  name             String
  iconUrl          String?          @map("icon_url")
  translations     Json?
  sortOrder        Int              @default(0) @map("sort_order")
